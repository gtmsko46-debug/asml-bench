{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/gtmsko46-debug/asml-bench/schemas/assumption_card.schema.json",
  "title": "AssumptionCard",
  "type": "object",
  "required": ["id", "version", "title", "flags", "parameters"],
  "properties": {
    "id": { "type": "string" },
    "version": { "type": "string" },
    "title": { "type": "string" },
    "scope": { "type": "string" },
    "flags": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "synthetic",
          "open-proxy",
          "not-asml-confidential",
          "needs-review"
        ]
      },
      "minItems": 1
    },
    "parameters": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name", "value", "unit", "source", "confidence", "flags"],
        "properties": {
          "name": { "type": "string" },
          "value": {},
          "unit": { "type": "string" },
          "source": { "type": "string", "minLength": 1 },
          "confidence": { "type": "string", "enum": ["low", "med", "high"] },
          "flags": { "type": "array", "items": { "type": "string" }, "minItems": 1 }
        }
      },
      "minItems": 1
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": true
}
